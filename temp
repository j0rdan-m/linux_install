Vagrant.configure("2") do |config|
  # 1. Base de la VM Kali Linux
  config.vm.box = "kalilinux/rolling"

  # 2. Configuration réseau (mode Bridge pour être sur le même réseau local que l'hôte)
  config.vm.network "public_network", bridge: "wlp2s0" # Remplace "enp0s3" par ton interface réseau

  # 3. Configuration des ressources
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "8192"
    vb.cpus = 2
  end

  # 4. Provision de la machine
  config.vm.provision "shell", inline: <<-SHELL
    # Ajouter la missing key 
    wget https://archive.kali.org/archive-keyring.gpg -O /usr/share/keyrings/kali-archive-keyring.gpg

    # Mettre à jour les dépôts et upgrader le système
    apt update

    # Créer un utilisateur 'pentester' avec un mot de passe sécurisé
    useradd -m -s /bin/bash pentester
    echo "pentester:pentestingIncoming" | chpasswd
    usermod -aG sudo pentester

    # Basculer le clavier en mode azerty FR
    echo "keyboard-configuration keyboard-configuration/layout select French" | debconf-set-selections
    echo "keyboard-configuration keyboard-configuration/variant select French" | debconf-set-selections
    apt install -y console-common
    loadkeys fr
    sed -i 's/XKBLAYOUT="us"/XKBLAYOUT="fr"/g' /etc/default/keyboard
    dpkg-reconfigure -f noninteractive keyboard-configuration

    # Redirection des logs vers la mémoire temporaire (/dev/shm)
    mkdir -p /dev/shm/logs
    chmod 1777 /dev/shm/logs

    # Rediriger journaux systèmes vers /dev/shm
    sed -i 's|/var/log|/dev/shm/logs|g' /etc/rsyslog.conf
    sed -i 's|/var/log|/dev/shm/logs|g' /etc/logrotate.conf
    systemctl restart rsyslog

    # Définir TMPDIR pour l'utilisateur 'pentester' (stockage temporaire sécurisé)
    echo "export TMPDIR=/dev/shm" >> /home/pentester/.bashrc
    chown pentester:pentester /home/pentester/.bashrc

    # Bannière au démarrage pour l'utilisateur
    echo "Bienvenue sur la machine de pentest. Logs et traces redirigés vers /dev/shm." > /etc/motd

  SHELL

  # 5. Ajouter un reboot après la configuration
  config.vm.provision "shell", inline: <<-SHELL
    echo "Rebooting the system to apply all changes..."
    reboot
  SHELL

end
